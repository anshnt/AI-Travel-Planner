{
  "name": "@atp/server",
  "version": "0.1.0",
  "private": true,
  "description": "HTTP API for the AI Travel Planner: destination data, forecasts and itinerary planning.",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "npm run build -w @atp/core && tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json",
    "demo": "npm run build -w @atp/core && tsx scripts/demo.ts",
    "diagrams": "npm run build -w @atp/core && tsx scripts/render-diagrams.ts",
    "measure": "npm run build -w @atp/core && tsx scripts/measure-optimisation.ts"
  },
  "dependencies": {
    "@atp/core": "*",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.15.3",
    "tsx": "^4.23.12"
  }
}
